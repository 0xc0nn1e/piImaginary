DEVICE_ID=pi-recorder-01
# auto selects ALSA on Linux and FFmpeg AVFoundation on macOS.
AUDIO_BACKEND=auto
# Linux USB example: plughw:CARD=Device,DEV=0
# macOS USB example: the AVFoundation audio index shown by ffmpeg, such as 2
AUDIO_DEVICE=default
RECORDING_DIR=./data/recordings
DATABASE_PATH=./data/recorder.db
CHUNK_MINUTES=10
SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_SAMPLE_FORMAT=S16_LE
ARECORD_BINARY=arecord
FFMPEG_BINARY=ffmpeg

# Leave blank to record locally without attempting uploads.
SERVER_URL=
UPLOAD_ENDPOINT=/api/v1/recordings
API_TOKEN=
UPLOAD_TIMEOUT_SECONDS=60
UPLOAD_POLL_SECONDS=10
RETRY_BASE_SECONDS=30
RETRY_MAX_SECONDS=3600

RETENTION_DAYS=7
MIN_FREE_DISK_MB=512
RECORD_RETRY_SECONDS=5
LOG_LEVEL=INFO
